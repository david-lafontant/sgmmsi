<%if vessel.mmsi.status%>
  <div class="card-body" id="<%= dom_id vessel %>">
    <p class="card-text">
      <strong>Registration number:</strong>
      <%= vessel.registration_number %>
    </p>
    <p class="card-text">
      <strong>Operation area:</strong>
      <%= vessel.operation_area %>
    </p>
    <p class="card-text">
      <strong>Last name:</strong>
      <%= vessel.last_name %>
    </p>
    <p class="card-text">
      <strong>First name:</strong>
      <%= vessel.first_name %>
    </p>
    <p class="card-text">
      <strong>Company name:</strong>
      <%= vessel.company_name %>
    </p>
    <p class="card-text">
      <strong>Email:</strong>
      <%= vessel.email %>
    </p>
    <p class="card-text">
      <strong>Telephone:</strong>
      <%= vessel.telephone %>
    </p>
    <p class="card-text">
      <strong>Mmsi:</strong>
      <%= vessel.mmsi_id %>
    </p>
    <p class="card-text">
      <strong>User:</strong>
      <%= vessel.user_id %>
    </p>
    <p class="card-text">
      <strong>Documents:</strong>
      <% vessel.documents.each do |document| %>
        <div><%= link_to document.filename, document, target: :blank, class: "btn btn-success" %></div>
      <% end %>
    </p>
  </div>
<%else%>
  <div class="card-body border border-danger border-4" id="<%= dom_id vessel %>">
    <p class="card-text">
      <%= link_to "Approve MMSI", edit_mmsi_url(vessel.mmsi.id), class: "btn btn-warning" %>
    </p>
    <p class="card-text">
      <strong>Numero d'immatriculation:</strong>
      <%= vessel.registration_number %>
    </p>
    <p class="card-text">
      <strong>Zone d'operation:</strong>
      <%= vessel.operation_area %>
    </p>
    <p class="card-text">
      <strong>Nom du navire:</strong>
      <%= vessel.name %>
    </p>
    <p class="card-text">
      <strong>Mmsi:</strong>
      <%= vessel.mmsi.mmsi_id %>
    </p>
    <p class="card-text">
      <strong>User:</strong>
      <%= vessel.user.email %>
    </p>
    <p class="card-text">
      <strong>Documents:</strong>
      <% vessel.documents.each do |document| %>
        <div><%= link_to document.filename, document, target: :blank, class: "btn btn-success" %></div>
      <% end %>
    </p>
  </div>
<%end%>