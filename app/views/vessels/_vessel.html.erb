<%if vessel.mmsi.status%>
  <div class="card-body" id="<%= dom_id vessel %>">
    <p class="card-text">
      <strong>Numero d'immatriculation:</strong>
      <%= vessel.registration_number %>
    </p>
    <p class="card-text">
      <strong>Zone d'operation:</strong>
      <%= vessel.operation_area %>
    </p>
    <p class="card-text">
      <strong>Nom du navire:</strong>
      <%= vessel.name %>
    </p>
    <p class="card-text">
      <strong>Mmsi:</strong>
      <%= vessel.mmsi.mmsi_id %>
    </p>
    <p class="card-text">
      <strong>Callsign:</strong>
      <%= vessel.get_callsign(vessel.mmsi_id) %>
    </p>
    <p class="card-text">
      <strong>User:</strong>
      <%= vessel.display_email(vessel.user_id) %>
    </p>
    <p class="card-text">
      <strong>Documents:</strong>
      <% vessel.documents.each do |document| %>
        <div><%= link_to document.filename, document, target: :blank, class: "btn btn-success" %></div>
      <% end %>
    </p>
  </div>
<%else%>
  <div class="card-body border border-danger border-4" id="<%= dom_id vessel %>">
    <p class="card-text">
      <%= link_to "Approve MMSI", edit_mmsi_url(vessel.mmsi.id), class: "btn btn-warning" %>
    </p>
    <p class="card-text">
      <strong>Numero d'immatriculation:</strong>
      <%= vessel.registration_number %>
    </p>
    <p class="card-text">
      <strong>Zone d'operation:</strong>
      <%= vessel.operation_area %>
    </p>
    <p class="card-text">
      <strong>Nom du navire:</strong>
      <%= vessel.name %>
    </p>
    <p class="card-text">
      <strong>Mmsi:</strong>
      <%= vessel.mmsi.mmsi_id %>
    </p>
    <p class="card-text">
      <strong>Callsign:</strong>
      <%= vessel.get_callsign(vessel.mmsi_id) %>
    </p>
    <p class="card-text">
      <strong>User:</strong>
      <%= vessel.display_email(vessel.user_id) %>
    </p>
    <p class="card-text">
      <strong>Documents:</strong>
      <% vessel.documents.each do |document| %>
        <div><%= link_to document.filename, document, target: :blank, class: "btn btn-success" %></div>
      <% end %>
    </p>
  </div>
<%end%>