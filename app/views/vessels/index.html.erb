<p style="color: green"><%= notice %></p>
<% content_for :title, "Vessels" %>
<div class="row">
  <div class="col d-flex flex-column mx-auto py-3">
    <h1>Vessels</h1>
    <div class="mb-3">
      <%= link_to "Ajouter navire", new_vessel_path, class: "btn btn-primary" %>
    </div>
    <div class="accordion" id="accordionExample">
      <div class="accordion-item">
        <h4 class="accordion-header">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
            Recherche avanc&eacute;
          </button>
        </h4>
        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
          <div class="accordion-body">
            <%= render "search" %>
          </div>
        </div>
      </div>
    </div>
    <div class="my-3">
      Found <%= @vessels.total_count %> vessels
    </div>
    <div class="my-b">
      <%= paginate @vessels, theme: 'bootstrap-5',
                   pagination_class: "pagination-sm flex-wrap justify-content-center",
                   nav_class: "d-inline-block" %>
    </div>
    <div id="vessels" class="table-responsive small mb-3">
      <table class="table table-striped table-sm">
        <thead>
          <tr>
            <th scope="col">Nom du Navire</th>
            <th scope="col">Registration Number</th>
            <th scope="col">Zone d'operation</th>
            <th scope="col">MMSI</th>
            <th scope="col">Callsign</th>
            <th scope="col">MMSI Status</th>
            <th scope="col">Details</th>
          </tr>
        </thead>
        <tbody>
          <% @vessels.each do |vessel| %>
            <tr>
              <td>
                <%= vessel.name%>
              </td>
              <td>
                <%= vessel.registration_number %>
              </td>
              <td>
                <%= vessel.operation_area %>
              </td>
              <td>
                <%= vessel.mmsi.mmsi_number %>
              </td>
              <td>
                <%= vessel.callsign.call_sign_num  %>
              </td>
              <td>
                <% if vessel.mmsi.status%>
                  <p>Approuv&eacute;</p>
                <%else%>
                  <p>Non Approuv&eacute;</p>
                <%end%>
              </td>
              <td>
                <%= link_to "Details", vessel %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="mb-3">
      <%= paginate @vessels, theme: 'bootstrap-5',
                   pagination_class: "pagination-sm flex-wrap justify-content-center",
                   nav_class: "d-inline-block" %>
    </div>
    <div>
      <%= link_to "Ajouter navire", new_vessel_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>