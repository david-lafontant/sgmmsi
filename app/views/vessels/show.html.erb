<p style="color: green"><%= notice %></p>
<div class="card box-shadow-02" %>
  <%= render @vessel %>
  <div class="card-footer">
    <%= link_to "Edit this vessel", edit_vessel_path(@vessel), class: "btn btn-warning m-2" %> |
    <%= link_to "Back to vessels", vessels_path, class: "btn btn-primary m-2" %>
    <% if user_signed_in? %>
      <% if current_user.admin? %>
        <%= button_to "Destroy this vessel", @vessel, method: :delete, class: "btn btn-danger m-2" %>
      <%end%>
    <%end%>
  </div>
</div>
