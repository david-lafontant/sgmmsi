<%= form_with(model: vessel, class: "d-flex flex-column p-2 m-2 box-shadow-01") do |form| %>
  <% if vessel.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(vessel.errors.count, "error") %> prohibited this vessel from being saved:</h2>
      <ul>
        <% vessel.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="input-group mb-3">
    <%= form.label :registration_number, "Numero d'immatriculation", class: "input-group-text" %>
    <%= form.text_field :registration_number, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :operation_area, "Zone d'operation", class: "input-group-text" %>
    <%= form.text_field :operation_area, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :name, "Nom du navire", class: "input-group-text" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :documents, class: "input-group-text" %>
    <%= form.file_field :documents, multiple: true, class: "form-control" %>
  </div>
  <div>
    <%= form.submit class: "btn btn-primary"%>
  </div>
<% end %>
