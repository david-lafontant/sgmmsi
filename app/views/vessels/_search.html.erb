<div>
  <%= search_form_for @q, url: vessels_path, method: :get do |f| %>
    <h2>Advanced Search</h2>
    <div class="input-group mb-3">
      <span class="input-group-text" ><%= f.label :name_cont, 'Nom du navire' %></span>
      <%= f.text_field :name_cont, class: 'form-control' , placeholder: 'Nom du navire...'%>
    </div>
    <div class="input-group mb-3">
      <span class="input-group-text" >
        <%= f.label :registration_number_eq, 'Immatriculation' %>
      </span>
      <%= f.text_field :registration_number_eq, class: 'form-control',
          placeholder: 'Immatriculation...' %>
    </div>
    <div class="input-group mb-3">
      <span class="input-group-text" >
        <%= f.label :operation_area_cont, 'Zone d\'operation...' %>
      </span>
      <%= f.text_field :operation_area_cont, class: 'form-control',
          placeholder: 'Zone d\'operation...' %>
    </div>
    <div class="mb-1">
    </div>
    <div class="input-group mb-3">
      <span class="input-group-text" >
        <%= f.label :mmsi_mmsi_number_cont, 'MMSI...' %>
      </span>
      <%= f.text_field :mmsi_mmsi_number_cont, class: 'form-control',
          placeholder: 'MMSI...' %>
    </div>
    <div class="input-group mb-3">
      <span class="input-group-text" >
        <%= f.label :callsign_call_sign_num_cont, 'Callsign...' %>
      </span>
      <%= f.text_field :callsign_call_sign_num_cont, class: 'form-control',
          placeholder: 'Callsign...' %>
    </div>
    <div class="mb-1">
      <%= f.label :user_id_eq, 'Operator', class: "form-label" %>
      <%= f.collection_select :user_id_eq,
          User.order(:email),
          :id, :email,
          { include_blank: 'Liste des operateurs' },
          { class: 'form-select form-select-lg mb-3' } %>
    </div>
    <div class="mb-1">
      <div class="form-check">
        <%= f.check_box :mmsi_status_eq, 
            { class: 'form-check-input' }, 
            'true', nil %>
        <%= f.label :active_eq, 'Navire approuvé', class: 'form-check-label' %>
      </div>
    </div>
    <div class="input-group mb-3">
      <span class="input-group-text" >
        <%= f.label :created_at_gteq, 'From Date' %>
      </span>
      <%= f.date_field :created_at_gteq, class: 'form-control' %>
    </div>
    <div class="input-group mb-3">
      <span class="input-group-text" >
        <%= f.label :created_at_lteq, 'To Date' %>
      </span>
      <%= f.date_field :created_at_lteq, class: 'form-control' %>
    </div>
    <div class="mb-1">
      <%= f.submit 'Search', class: 'btn btn-primary' %>
      <%= link_to 'Reset', vessels_path, class: 'btn btn-secondary' %>
    <% end %>
  </div>
