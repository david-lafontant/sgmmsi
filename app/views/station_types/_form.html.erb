<%= form_with(model: station_type, class: "d-flex flex-column p-2 m-2") do |form| %>
  <% if station_type.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(station_type.errors.count, "error") %> prohibited this station_type from being saved:</h2>
      <ul>
        <% station_type.errors.each do |error| %>
