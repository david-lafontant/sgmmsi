<% content_for :title, "Station types" %>
<div class="row">
  <div class="col col-md-8 d-flex flex-column mx-auto py-3">
    <% if !notice.blank? %>
      <p style="color: green"><%= notice %></p>
    <%end%>
    <h1>Station types</h1>
    <div id="station_types" class= "border border-dark border-rounded">
      <% @station_types.each do |station_type| %>
        <%= render station_type %>
        <p>
          <%= link_to "Show this station type", station_type, class: "btn btn-success" %>
        </p>
      <% end %>
    </div>
    <%= link_to "New station type", new_station_type_path %>
  </div>
</div>