<div class="row">
  <div class="col col-md-8 d-flex flex-column mx-auto py-3">
    <% if !notice.blank? %>
      <p style="color: green"><%= notice %></p>
    <%end%>
    <%= render @station_type %>
    <div>
      <% if user_signed_in? %>
        <% if current_user.admin? %>
          <%= link_to "Edit this station type", edit_station_type_path(@station_type), class: "btn btn-warning" %> |
          <%= button_to "Destroy this station type", @station_type, method: :delete, class: "btn btn-danger" %>
        <%end%>
      <%end%>
      <%= link_to "Back to station types", station_types_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>