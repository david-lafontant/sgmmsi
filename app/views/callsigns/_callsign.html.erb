<div id="<%= dom_id callsign %>">
  <p>
    <strong>Call sign num:</strong>
    <%= callsign.call_sign_num %>
  </p>

  <p>
    <strong>Mmsi:</strong>
    <%= callsign.mmsi_id %>
  </p>

  <p>
    <strong>User:</strong>
    <%= callsign.user_id %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= callsign.status %>
  </p>

  <p>
    <strong>Documents:</strong>
    <% callsign.documents.each do |document| %>
      <div><%= link_to document.filename, document %></div>
    <% end %>
  </p>

</div>
