<p style="color: green"><%= notice %></p>

<% content_for :title, "Callsigns" %>

<h1>Callsigns</h1>

<div id="callsigns">
  <% @callsigns.each do |callsign| %>
    <%= render callsign %>
    <p>
      <%= link_to "Show this callsign", callsign %>
    </p>
  <% end %>
</div>

<%= link_to "New callsign", new_callsign_path %>
