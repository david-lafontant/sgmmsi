<%= form_with(model: callsign) do |form| %>
  <% if callsign.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(callsign.errors.count, "error") %> prohibited this callsign from being saved:</h2>
      <ul>
        <% callsign.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="input-group mb-3">
    <%= form.label :mmsi_id, class: "input-group-text" %>
    <%= form.collection_select :mmsi_id, Mmsi.all, :id, :mmsi_id, prompt: true, class: "form-control"%>
  </div>
  <div class="mb-3">
    <%= form.label :documents, style: "display: block" %>
    <%= form.file_field :documents, multiple: true %>
  </div>
  <div>
    <%= form.submit class: "btn btn-success" %>
  </div>
<% end %>
