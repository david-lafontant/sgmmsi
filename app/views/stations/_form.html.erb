<%= form_with(model: station, class: "d-flex flex-column p-2 m-2 box-shadow-01") do |form| %>
  <% if station.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(station.errors.count, "error") %> prohibited this station from being saved:</h2>
      <ul>
        <% station.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="input-group mb-3">
    <%= form.label :registration_number, class: "input-group-text"%>
    <%= form.text_field :registration_number, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :latitude, class: "input-group-text"%>
    <%= form.text_field :latitude, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :longitude, class: "input-group-text"%>
    <%= form.text_field :longitude, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :municipality, class: "input-group-text"%>
    <%= form.text_field :municipality, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :station_type_id, class: "input-group-text" %>
    <%= form.collection_select :station_type_id, StationType.all, :id, :category, prompt: true, class: "form-control"%>
  </div>
  <div class="input-group mb-3">
    <%= form.label :last_name, class: "input-group-text"%>
    <%= form.text_field :last_name, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :first_name, class: "input-group-text"%>
    <%= form.text_field :first_name, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :company_name, class: "input-group-text"%>
    <%= form.text_field :company_name, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :email, class: "input-group-text"%>
    <%= form.email_field :email , class: "form-control" %>
  </div>
  <div>
    <%= form.label :telephone, class: "input-group-text"%>
    <%= form.telephone_field :telephone, class: "form-control" %>
  </div>
  <div class="input-group mb-3">
    <%= form.label :documents, class: "input-group-text"%>
    <%= form.file_field :documents, multiple: true, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.submit , class: "btn btn-primary" %>
  </div>
<% end %>
