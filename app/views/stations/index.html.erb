<p style="color: green"><%= notice %></p>
<% content_for :title, "Stations" %>
<div class="row">
  <div class="col d-flex flex-column mx-auto py-3">
    <h1>Stations</h1>
    <div class="accordion my-3" id="accordionAddVessels">
      <div class="accordion-item">
        <h4 class="accordion-header">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accordionAddStations" aria-expanded="false" aria-controls="accordionAddStations">
            Ajouter des stations
          </button>
        </h4>
        <div id="accordionAddStations" class="accordion-collapse collapse" data-bs-parent="#accordionAddStations">
          <div class="accordion-body">
            <div class="mb-3">
              <%= link_to "Ajouter une station", new_station_path, class: "btn btn-primary" %>
            </div>
            <div class="line-behind-text">
              <h2>
                or
              </h2>
            </div>
            <%= render "import" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="accordion" id="accordion2">
  <div class="accordion-item">
    <h4 class="accordion-header">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
        Recherche avanc&eacute;
      </button>
    </h4>
    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordion2">
      <div class="accordion-body">
        <%= render "search" %>
      </div>
    </div>
  </div>
</div>
<div class="my-3">
  Found <%= @stations.total_count %> stations
</div>
<div class="mb-3">
  <%= paginate @stations, theme: 'bootstrap-5',
                   pagination_class: "pagination-sm flex-wrap justify-content-center",
                   nav_class: "d-inline-block" %>
</div>
<div id="stations" class="table-responsive small mb-3">
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th scope="col">Registration Number</th>
        <th scope="col">Type</th>
        <th scope="col">MMSI</th>
        <th scope="col">Callsign</th>
        <th scope="col">MMSI Status</th>
        <th scope="col">Details</th>
      </tr>
    </thead>
    <tbody>
      <% @stations.each do |station| %>
        <tr>
          <td>
            <%= station.registration_number%>
          </td>
          <td>
            <%= station.station_type.category %>
          </td>
          <td>
            <%= station.mmsi.mmsi_number %>
          </td>
          <td>
            <%= station.callsign.call_sign_num %>
          </td>
          <td>
            <% if station.mmsi.status%>
              <p>Approuv&eacute</p>
            <%else%>
              <p>Non Approuv&eacute</p>
            <%end%>
          </td>
          <td>
            <%= link_to "Details", station %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mb-3">
  <%= paginate @stations, theme: 'bootstrap-5',
                   pagination_class: "pagination-sm flex-wrap justify-content-center",
                   nav_class: "d-inline-block" %>
</div>
<%= link_to "New station", new_station_path, class: "btn btn-primary" %>
</div>
</div>
