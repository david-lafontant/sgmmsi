<p style="color: green"><%= notice %></p>
<% content_for :title, "Stations" %>
<div class="row">
  <div class="col col-md-8 d-flex flex-column mx-auto py-3">
    <h1>Stations</h1>
    <div id="stations">
      <% @stations.each do |station| %>
        <%= render station %>
        <p>
          <%= link_to "Show this station", station %>
        </p>
      <% end %>
    </div>
    <%= link_to "New station", new_station_path, class: "btn btn-primary bg-" %>
  </div>
</div>
