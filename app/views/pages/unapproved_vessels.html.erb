<p style="color: green"><%= notice %></p>
<% content_for :title, "Unnaproved Vessels" %>
<div class="row">
  <div class="col d-flex flex-column mx-auto py-3">
    <h1>Navires non approuv&eacute;s</h1>
    <div class="accordion" id="accordionThree">
      <div class="accordion-item">
        <h4 class="accordion-header">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
            T&eacute;l&eacute;charger la liste
          </button>
        </h4>
        <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionThree">
          <div class="accordion-body">
            <div class="mb-1">
              <%= link_to "version csv", unapproved_vessels_path(format: :csv) , class: "d-block button-37", download: "navires_non_approuves_#{Time.current.strftime("%m-%d-%Y--%H-%M-%S")}.csv" %>
            </div>
            <div class="mb-1">
              <%= link_to "version excel", unapproved_vessels_path(format: :xlsx), class: "d-block button-37" , download: "navires_non_approuves_#{Time.current.strftime("%m-%d-%Y--%H-%M-%S")}.xlsx"%>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="my-3">
      <%= paginate @vessels, theme: 'bootstrap-5',
                   pagination_class: "pagination-sm flex-wrap justify-content-center",
                   nav_class: "d-inline-block" %>
    </div>
    <div id="unapproved_vessels" class="table-responsive small mb-3">
      <table class="table table-striped table-sm">
        <thead>
          <tr>
            <th scope="col">Nom du Navire</th>
            <th scope="col">Immatriculation</th>
            <th scope="col">Zone d'operation</th>
            <th scope="col">MMSI</th>
            <th scope="col">Callsign</th>
            <th scope="col">MMSI Status</th>
            <th scope="col">Details</th>
          </tr>
        </thead>
        <tbody>
          <% @vessels.each do |vessel| %>
            <tr>
              <td>
                <%= vessel.name%>
              </td>
              <td>
                <%= vessel.registration_number %>
              </td>
              <td>
                <%= vessel.operation_area %>
              </td>
              <td>
                <%= vessel.mmsi.mmsi_number %>
              </td>
              <td>
                <%=vessel.callsign.call_sign_num %>
              </td>
              <td>
                <% if vessel.mmsi.status%>
                  <p>Approuv&eacute;</p>
                <%else%>
                  <p>Non Approuv&eacute;</p>
                <%end%>
              </td>
              <td>
                <%= link_to "Details", vessel_url(vessel.id) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="mb-3">
      <%= paginate @vessels, theme: 'bootstrap-5',
                   pagination_class: "pagination-sm flex-wrap justify-content-center",
                   nav_class: "d-inline-block" %>
    </div>
  </div>
</div>