<div class="container my-5">
  <div class="p-5 text-center bg-body-tertiary rounded-3">
    <%= image_tag "logo.png", size: "100x100" , class: "bi mt-4 mb-3" , alt: "logo"%>
    <h1 class="text-body-emphasis">SGMMSI</h1>
    <p class="col-lg-8 mx-auto fs-5 text-muted">
      Systeme de Gestion des MMSI
    </p>
    <div class="d-flex flex-column flex-md-row gap-2 justify-content-center align-items-center  mb-5 ">
      <%= link_to vessels_path, class: "button-29" do %>
        Ajouter Navire
      <%end%>
      <%= link_to dashboard_path, class: "button-29" do %>
        Dashboard
      <%end%>
      <%= link_to stations_path, class: "button-29" do %>
        Ajouter Station
      <%end%>
    </div>
  </div>
</div>
