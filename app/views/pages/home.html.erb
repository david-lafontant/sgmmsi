<div class="container my-5">
  <div class="p-5 text-center bg-body-tertiary rounded-3">
    <%= image_tag "logo.png", size: "100x100" , class: "bi mt-4 mb-3" , alt: "logo"%>
    <h1 class="text-body-emphasis">SGMMSI</h1>
    <p class="col-lg-8 mx-auto fs-5 text-muted">
      Systeme de Gestion des MMSI
    </p>
    <div class="d-inline-flex gap-2 mb-5">
      <%= link_to vessels_path, class: "d-inline-flex align-items-center btn btn-primary btn-lg px-4 rounded-pill" do %>
        Ajouter Navire
        <svg class="bi ms-2" width="24" height="24"><use xlink:href="#arrow-right-short"/></svg>
      <%end%>
      <%= link_to dashboard_path, class: "btn btn-outline-primary btn-lg px-4 rounded-pill" do %>
        Dashboard
      <%end%>
      <%= link_to stations_path, class: "btn btn-outline-secondary btn-lg px-4 rounded-pill" do %>
        Ajouter Station
      <%end%>
    </div>
  </div>
</div>
