<%= field = [:immatriculation, :zone, :mmsi, :callsign, :date].join(",") %>
<% @vessels.each do |vessel| %>
  <% registration = vessel.registration_number %>
  <% area = vessel.operation_area %>
  <% mmsi =  vessel.mmsi.mmsi_id.to_s %>
  <% callsign = vessel.callsign.call_sign_num %>
  <% date = vessel.created_at.strftime("%d/%B/%Y")%>
  <%= [registration, area, mmsi, callsign, date].join(",") %>
<% end %>