<div class="row" >
  <div class="col">
    <h1>
      Dashboard
    </h1>
  </div>
</div>
<div class="row p-2 gap-sm-2">
  <div class="col-sm-12 col-md-4 mb-2">
    <div class="card">
      <div class="card-body">
        <p>
          <span>Stations:</span>&nbsp;<span class="badge bg-warning"><%= @stations  %></span>
        </p>
      </div>
    </div>
  </div>
  <div class="col col-md-4 mb-2">
    <div class="card">
      <div class="card-body">
        <p>
          <span>Vessels:</span>&nbsp;<span class="badge bg-warning"><%= @vessels  %></span>
        </p>
      </div>
    </div>
  </div>
</div>
<div class="row p-2 gap-sm-2">
  <div class="col-sm-12 col-md-4 mb-2">
    <%= link_to unapproved_vessels_path do %>
      <div class="card">
        <div class="card-body">
          <p>
            Total unapproved vessels: <%=  @unapproved_vessels %>
          </p>
        </div>
      </div>
    <%end%>
  </div>
  <div class="col col-md-4 mb-2">
    <%= link_to unapproved_stations_path do %>
      <div class="card">
        <div class="card-body">
          <p>
            Total unapproved station: <%=  @unapproved_stations %>
          </p>
        </div>
      </div>
    <%end%>
  </div>
</div>
