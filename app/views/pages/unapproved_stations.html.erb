<p style="color: green"><%= notice %></p>
<% content_for :title, "Stations" %>
<div class="row">
  <div class="col d-flex flex-column mx-auto py-3">
    <h1>Stations non approuv&eacute;es</h1>
    <div class="accordion" id="accordionExample">
      <div class="accordion-item">
        <h4 class="accordion-header">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
            T&eacute;l&eacute;charger la liste
          </button>
        </h4>
        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
          <div class="accordion-body">
            <div class="mb-1">
              <%= link_to "version csv", unapproved_stations_path(format: :csv) , class: "d-block button-37", download: "stations_non_approuvees_#{Time.current.strftime("%m-%d-%Y--%H-%M-%S")}.csv" %>
            </div>
            <div class="mb-1">
              <%= link_to "version excel", unapproved_stations_path(format: :xlsx), class: "d-block button-37" , download: "stations_non_approuvees_#{Time.current.strftime("%m-%d-%Y--%H-%M-%S")}.xlsx"%>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="my-3">
      <%= paginate @stations, theme: 'bootstrap-5',
                   pagination_class: "pagination-sm flex-wrap justify-content-center",
                   nav_class: "d-inline-block" %>
    </div>
    <div id="unapproved_stations" class="table-responsive small mb-3">
      <table class="table table-striped table-sm">
        <thead>
          <tr>
            <th scope="col">Immatriculation</th>
            <th scope="col">Type</th>
            <th scope="col">MMSI</th>
            <th scope="col">Callsign</th>
            <th scope="col">MMSI Status</th>
            <th scope="col">Details</th>
          </tr>
        </thead>
        <tbody>
          <% @stations.each do |station| %>
            <tr>
              <td>
                <%= station.registration_number%>
              </td>
              <td>
                <%= station.station_type.category %>
              </td>
              <td>
                <%= station.mmsi.mmsi_number %>
              </td>
              <td>
                <%= station.callsign.call_sign_num %>
              </td>
              <td>
                <% if station.mmsi.status%>
                  <p>Approuv&eacute;</p>
                <%else%>
                  <p>Non Approuv&eacute;</p>
                <%end%>
              </td>
              <td>
                <%= link_to "Details", station %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="mb-3">
        <%= paginate @stations, theme: 'bootstrap-5',
                   pagination_class: "pagination-sm flex-wrap justify-content-center",
                   nav_class: "d-inline-block" %>
      </div>
    </div>
  </div>
</div>
